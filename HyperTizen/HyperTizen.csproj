<Project Sdk="Tizen.NET.Sdk/1.1.9">

  <!-- Property Group for .NET Core Project -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>tizen90</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Opt-in build for Tizen 5.5 TVs (2020 models, e.g. Q80T): dotnet build -c Release -p:Tizen55=true
    - tizen60: the TV ships .NET Core 3.0. A tizen90 build references System.Runtime 4.2.2 (Core 3.1)
      and the service dies at start without writing a log.
    - tizen-manifest.tizen55.xml: api-version 5.5. With 6.5/9, vd_appinstall fails with
      "install failed[118, -4] Operation not allowed".
    The default build (tizen90, tizen-manifest.xml) is unchanged.
  -->
  <PropertyGroup Condition=" '$(Tizen55)' == 'true' ">
    <TargetFramework>tizen60</TargetFramework>
    <TizenManifestFile>tizen-manifest.tizen55.xml</TizenManifestFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="lib\" />
    <Folder Include="res\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
    <PackageReference Include="Rssdp" Version="4.0.4" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

</Project>
